{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JitDub",
  "version": "0.1.0",
  "identifier": "cc.moelibre.jitdub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JitDub",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": false,
        "backgroundColor": "#1E1F22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
