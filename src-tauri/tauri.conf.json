{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JitDub",
  "version": "../package.json",
  "identifier": "cc.moelibre.jitdub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JitDub",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": false,
        "backgroundColor": "#1E1F22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3OUQwMUI3NThEMjhCQTMKUldTamk5Sll0d0dkUnhhZDdVWVNoTmIvMHBCNDVodCtubWNSNFFvYnM1SExxOVoxQ3dEaG9takQK",
      "endpoints": [
        "https://github.com/JitDub-Voice/jitdub-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
